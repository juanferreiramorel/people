# Required. Secret used to sign and verify JWTs (HS256), at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional. URLs of pre-built SQLite databases (skip the DNIT crawl when set).
RUC_DB_URL=
PEOPLE_DB_URL=

# Optional. Set to true to expose /docs, /redoc and /openapi.json.
ENABLE_DOCS=false
